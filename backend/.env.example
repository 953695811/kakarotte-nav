# ==========================================
# 服务端配置
# ==========================================
PORT=3000

# JWT 密钥（必须修改，不然你的 token 谁都能伪造）
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ==========================================
# 微信开放平台 - 网站应用扫码登录
# 申请地址：https://open.weixin.qq.com/
# 注意：redirect_uri 必须是备案过的 HTTPS 公网域名，并且在开放平台后台配置过
# 本地开发（localhost）无法使用真实微信回调，请使用「模拟扫码」接口先跑通流程
# ==========================================
WECHAT_APPID=
WECHAT_APPSECRET=
# 例如：https://yourdomain.com/api/wechat/callback
WECHAT_REDIRECT_URI=
